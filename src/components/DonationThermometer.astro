---
import { progressPercent, formatRand } from '../lib/campaign';
interface Props { raised: number; goal: number; }
const { raised, goal } = Astro.props;
const pct = progressPercent(raised, goal);
---
<div class="thermo">
  <div class="thermo-track">
    <div class="thermo-fill" data-fill={pct} style="width:0%" role="img" aria-label={`${formatRand(raised)} raised of ${formatRand(goal)} goal (${pct}%)`}></div>
  </div>
  <div class="thermo-meta">
    <span class="raised">{formatRand(raised)} raised</span>
    <span class="goal">of {formatRand(goal)} goal</span>
  </div>
</div>
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.thermo-fill').forEach((el) => {
    const target = (el.dataset.fill || '0') + '%';
    if (reduce) { el.style.width = target; return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        requestAnimationFrame(() => { el.style.width = target; });
      });
    }, { threshold: 0.4 });
    io.observe(el);
  });
</script>
