---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/what-we-do', label: 'What We Do' },
  { href: '/campaign', label: 'Campaign' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/events', label: 'Events' },
  { href: '/get-involved', label: 'Get Involved' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <span class="brand-mark">S</span>
      <span>
        <span class="brand-name">Sivulingqondo</span><br />
        <span class="brand-sub">Community Project &amp; ECD</span>
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map((l) => <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>)}
    </nav>
    <div class="header-cta">
      <button class="menu-btn" aria-label="Menu" id="menuBtn"><span></span><span></span><span></span></button>
      <a class="btn btn-primary btn-sm donate-top" href="/campaign">Donate</a>
    </div>
  </div>
</header>
<script>
  const mb = document.getElementById('menuBtn');
  mb && mb.addEventListener('click', () => document.body.classList.toggle('menu-open'));
  document.querySelectorAll('.nav a').forEach((a) =>
    a.addEventListener('click', () => document.body.classList.remove('menu-open'))
  );
</script>
