---
import BaseLayout from '../layouts/BaseLayout.astro';
import BankDetails from '../components/BankDetails.astro';
import site from '../data/site.json';
import page from '../data/pages/get-involved.json';

function resolveUrl(u: string): string {
  if (u === 'forGood') return site.forGood;
  if (u === 'whatsapp') return `https://wa.me/${site.whatsapp}`;
  return u;
}
function isExternal(u: string): boolean {
  return u === 'forGood' || u === 'whatsapp' || /^https?:\/\//.test(u);
}
const cards = page.cards && page.cards.length ? page.cards : [];
---
<BaseLayout title={`Get Involved — ${site.orgName}`} description="Donate, volunteer, partner, or donate goods.">
  <section class="section"><div class="container">
    <h1>{page.heading || 'Get Involved'}</h1>
    <div class="grid grid-2">
      {cards.map((card, i) => {
        const url = resolveUrl(card.buttonUrl);
        const ext = isExternal(card.buttonUrl);
        return (
          <div class="card" style="padding:var(--space-3)">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <a class={i % 2 === 0 ? 'btn btn-primary' : 'btn btn-secondary'} href={url} {...(ext ? { target: '_blank', rel: 'noopener' } : {})}>{card.buttonLabel}</a>
          </div>
        );
      })}
    </div>
    <div style="margin-top:var(--space-4)">
      <BankDetails />
    </div>
  </div></section>
</BaseLayout>
