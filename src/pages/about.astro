---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { md } from '../lib/markdown';
import site from '../data/site.json';
import about from '../data/pages/about.json';
const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const regNote = site.npoNumber || site.pboNumber ? ' We are a registered NPO/PBO.' : '';
---
<BaseLayout title={`About — ${site.orgName}`} description="Our story, mission, and team.">
  <section class="section"><div class="container">
    <h1>{about.heading || 'About Us'}</h1>
    <h2>{about.storyHeading || 'Our Story'}</h2>
    <div class="prose" set:html={md(about.storyBody)}></div>
    <h2>{about.missionHeading || 'Mission'}</h2>
    <div class="prose" set:html={md(about.missionBody)}></div>
    <h2>{about.teamHeading || 'Our Team'}</h2>
    <div class="grid grid-3">
      {team.map((m) => (
        <div class="card" style="padding:var(--space-3)">
          <h3 style="margin-bottom:.2rem">{m.data.name}</h3>
          <p style="color:var(--c-muted)">{m.data.role}</p>
        </div>
      ))}
    </div>
    <h2>{about.transparencyHeading || 'Transparency'}</h2>
    <div class="prose" set:html={md((about.transparencyBody || '') + regNote)}></div>
  </div></section>
</BaseLayout>
