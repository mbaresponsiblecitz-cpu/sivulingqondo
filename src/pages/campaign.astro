---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DonationThermometer from '../components/DonationThermometer.astro';
import ImpactTiers from '../components/ImpactTiers.astro';
import BankDetails from '../components/BankDetails.astro';
import { formatRand } from '../lib/campaign';
import { md } from '../lib/markdown';
import site from '../data/site.json';
import page from '../data/pages/campaign.json';
const c = site.campaign;
const proof = (await getCollection('transparency'));
---
<BaseLayout title={`${c.title} — ${site.orgName}`} description="Help 15 children learn with dignity. Goal: R16,500.">
  <section class="section"><div class="container">
    {page.posterImage && (
      <figure class="event-poster">
        <img src={page.posterImage} alt={page.posterCaption || 'Campaign event poster'} loading="eager" />
        {page.posterCaption && <figcaption>{page.posterCaption}</figcaption>}
      </figure>
    )}
    <h1>{c.title}</h1>
    <div class="lede prose" set:html={md(page.intro)}></div>
    <DonationThermometer raised={c.raised} goal={c.goal} />
    <p><a class="btn btn-primary" href={site.forGood} target="_blank" rel="noopener">{page.donateLabel || 'Donate via ForGood'}</a></p>

    <BankDetails />

    <h2>{page.fundsHeading || 'What your donation funds'}</h2>
    <ImpactTiers tiers={c.tiers} />

    <h2>{page.budgetHeading || 'Budget breakdown'}</h2>
    <table class="budget">
      <tbody>
        {c.lineItems.map((li) => (
          <tr><td>{li.label}</td><td class="amt">{formatRand(li.amount)}</td></tr>
        ))}
        <tr class="total"><td>Total Goal</td><td class="amt">{formatRand(c.goal)}</td></tr>
      </tbody>
    </table>

    <h2>{page.transparencyHeading || 'Full transparency'}</h2>
    <p>{page.transparencyIntro || '100% of funds go directly to furniture and safety equipment. We post photos and invoices of every purchase below.'}</p>
    {proof.length > 0 ? (
      <div class="grid grid-3">
        {proof.map((p) => (
          <figure class="card" style="margin:0">
            <img src={p.data.image} alt={p.data.title} loading="lazy" width="600" height="400" style="aspect-ratio:3/2;object-fit:cover" />
            <figcaption style="padding:var(--space-2)">{p.data.title}
              {p.data.invoice && <> · <a href={p.data.invoice} target="_blank" rel="noopener">View invoice</a></>}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p>{page.emptyState || 'Photos and invoices will be posted here as soon as we begin purchasing.'}</p>
    )}
  </div></section>
</BaseLayout>
<style>
  .event-poster { max-width: 480px; margin: 0 auto var(--space-4); }
  .event-poster img { width: 100%; height: auto; border-radius: var(--radius); box-shadow: var(--shadow); display: block; }
  .event-poster figcaption { margin-top: var(--space-2); text-align: center; color: var(--ink-soft); font-size: .95rem; }
  .lede { font-size: 1.15rem; max-width: 55ch; }
  .budget { width: 100%; max-width: 520px; border-collapse: collapse; }
  .budget td { padding: .6rem 0; border-bottom: 1px solid #e3d7c6; }
  .budget .amt { text-align: right; font-variant-numeric: tabular-nums; }
  .budget .total td { font-weight: 800; border-bottom: 0; color: var(--c-terracotta); }
</style>
